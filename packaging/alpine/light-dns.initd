#!/sbin/openrc-run

description="Serveur DNS light-dns"
supervisor="supervise-daemon"
command="/usr/local/bin/light-dns"
command_args="--config /etc/light-dns/config.toml --socket /run/light-dns/control.sock"
command_user="light-dns:light-dns"
directory="/var/lib/light-dns"
required_files="/etc/light-dns/config.toml"
respawn_delay=5
respawn_max=5
respawn_period=60
retry="TERM/10/KILL/5"
output_logger="logger -t light-dns"
error_logger="logger -t light-dns"
extra_started_commands="reload"
description_reload="Recharger explicitement la configuration TOML"

depend() {
    need net
    use logger
}

start_pre() {
    checkpath --directory --mode 0700 --owner light-dns:light-dns /run/light-dns || return 1
    checkpath --directory --mode 0750 --owner light-dns:light-dns /var/lib/light-dns || return 1
    checkpath --directory --mode 0700 --owner light-dns:light-dns /var/lib/light-dns/filters
}

reload() {
    ebegin "Rechargement de light-dns"
    "${command}" --socket /run/light-dns/control.sock reload
    eend $?
}
